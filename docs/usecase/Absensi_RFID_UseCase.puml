@startuml Use Case Diagram - Sistem Absensi IoT RFID

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8F9FA
  BorderColor #333333
  ArrowColor #333333
  FontSize 13
}
skinparam actor {
  BackgroundColor #333333
  FontColor #333333
  FontSize 14
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 16
  FontStyle bold
}
skinparam shadowing false
skinparam defaultFontName "Helvetica"

rectangle "Sistem Absensi Berbasis IoT" as boundary {

  ' === Use Case Admin ===
  (Login) as UC1
  (Kelola Data Karyawan) as UC2
  (Kelola Data Divisi) as UC3
  (Kelola Jadwal Kerja) as UC4
  (Input Absensi Manual) as UC5
  (Lihat Laporan Absensi) as UC6
  (Export/Cetak Laporan) as UC7

  ' === Use Case Karyawan ===
  (Tap Kartu RFID) as UC8

  ' === Use Case Device RFID ===
  (Proses & Simpan\nData Absensi) as UC9

  ' === Relasi Include ===
  UC8 ..> UC9 : <<include>>
}

' === Aktor ===
actor "Admin" as Admin
actor "Karyawan" as Karyawan
actor "Device RFID" as Device

' === Relasi Admin ===
Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7

' === Relasi Karyawan ===
Karyawan --> UC8

' === Relasi Device RFID ===
Device --> UC9

@enduml