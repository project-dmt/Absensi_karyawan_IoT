APP_NAME="Absensi IoT RFID"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

APP_TIMEZONE=Asia/Jakarta

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absensi_iot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# API Key untuk komunikasi ESP32 <-> Backend (ganti dengan key unik di production)
# Support multiple keys (comma-separated) untuk rotation tanpa downtime
# Contoh: API_KEY=key_baru,key_lama
API_KEY=your-esp32-api-key-here

# URL Frontend React (untuk CORS)
FRONTEND_URL=http://localhost:5173

# Sanctum Stateful Domains (untuk SPA auth)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

# Sanctum Token Expiration (dalam menit, default 24 jam)
SANCTUM_TOKEN_EXPIRATION_MINUTES=1440
